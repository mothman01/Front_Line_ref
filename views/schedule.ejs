<%- include('partials/header') %>

<section class="page-hero">
  <div class="container">
    <h1>Class Calendar</h1>
    <p class="section-lede">Pick a class day to see the details and reserve your seat. Seat counts update live.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="calendar" data-month="<%= month.key %>">
      <div class="calendar-head">
        <a href="/schedule?month=<%= month.prev %>" class="btn btn-ghost btn-sm" aria-label="Previous month">&larr;</a>
        <h2><%= month.label %></h2>
        <a href="/schedule?month=<%= month.next %>" class="btn btn-ghost btn-sm" aria-label="Next month">&rarr;</a>
      </div>
      <% if (!month.isCurrentMonth) { %>
        <p class="calendar-today-link"><a href="/schedule" class="text-link">Back to this month</a></p>
      <% } %>

      <div class="calendar-grid" role="grid">
        <% ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach(function (d) { %>
          <div class="calendar-dow" role="columnheader"><%= d %></div>
        <% }) %>
        <% month.cells.forEach(function (cell) { %>
          <% if (!cell) { %>
            <div class="calendar-cell is-empty"></div>
          <% } else { %>
            <% const dayEvents = byDay[cell.key] || []; %>
            <div class="calendar-cell<%= cell.isToday ? ' is-today' : '' %><%= cell.isPast ? ' is-past' : '' %><%= dayEvents.length ? ' has-classes' : '' %>" role="gridcell">
              <span class="calendar-daynum"><%= cell.day %><% if (cell.isToday) { %><span class="today-label">Today</span><% } %></span>
              <% dayEvents.forEach(function (e) { %>
                <a href="/class/<%= e.id %>" class="calendar-class<%= e.seats_left === 0 ? ' is-full' : '' %><%= e.past ? ' is-over' : '' %>">
                  <span class="calendar-class-time"><%= e.time %></span>
                  <span class="calendar-class-title"><%= e.title %></span>
                  <span class="calendar-class-seats" data-seat-id="<%= e.id %>" data-seat-format="long"><%= e.past ? 'Ended' : (e.seats_left === 0 ? 'Full' : e.seats_left + ' of ' + e.capacity + ' seats left') %></span>
                </a>
              <% }) %>
            </div>
          <% } %>
        <% }) %>
      </div>
    </div>

    <div class="month-list">
      <h3>Classes in <%= month.label %></h3>
      <% if (monthEvents.length) { %>
        <% monthEvents.forEach(function (e) { %>
          <a href="/class/<%= e.id %>" class="month-list-item<%= e.past ? ' is-over' : '' %>">
            <span class="month-list-date"><%= new Date(e.day + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' }) %> &middot; <%= e.time %></span>
            <span class="month-list-title"><%= e.title %><% if (e.price) { %> &middot; <%= e.price %><% } %></span>
            <span class="seat-pill<%= e.seats_left === 0 ? ' is-full' : '' %>" data-seat-id="<%= e.id %>"><%= e.past ? 'Ended' : (e.seats_left === 0 ? 'Full' : e.seats_left + ' seats left') %></span>
          </a>
        <% }) %>
      <% } else { %>
        <p class="muted">No classes scheduled this month yet. Check the next month or request a private session below.</p>
      <% } %>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container narrow">
    <h2>Request a Private Session</h2>
    <p class="section-lede">Prefer one-on-one coaching? Send a request and we'll confirm by email.</p>
    <% if (success) { %>
      <div class="alert alert-success">
        Your appointment request was received. Please complete the <a href="/waiver">liability waiver</a> before your session.
      </div>
    <% } else { %>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="post" action="/schedule" class="admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label>
          Your name
          <input type="text" name="customer_name" value="<%= form && form.customer_name || '' %>" required />
        </label>
        <label>
          Email
          <input type="email" name="email" value="<%= form && form.email || '' %>" required />
        </label>
        <label>
          Phone
          <input type="tel" name="phone" value="<%= form && form.phone || '' %>" />
        </label>
        <label>
          Course
          <select name="course" required>
            <option value="">— Select a course —</option>
            <% (courses || []).forEach(function (c) { %>
              <option value="<%= c.name %>"><%= c.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Preferred date &amp; time
          <input type="datetime-local" name="scheduled_at" required />
        </label>
        <label>
          Notes (optional)
          <textarea name="notes" rows="3"><%= form && form.notes || '' %></textarea>
        </label>

        <button type="submit" class="btn btn-primary">Request Appointment</button>
      </form>

    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
