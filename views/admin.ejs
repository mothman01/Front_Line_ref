<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Front Line Refinement</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
  <header class="admin-header">
    <div class="container admin-header-inner">
      <a href="/admin" class="brand">
        <span class="brand-mark">FLR</span>
        <span class="brand-text"><span class="brand-name">Admin Panel</span></span>
      </a>
      <nav class="admin-nav">
        <a href="/admin?section=bio" class="<%= section === 'bio' ? 'active' : '' %>">Biography &amp; About</a>
        <a href="/admin?section=courses" class="<%= section === 'courses' ? 'active' : '' %>">Courses</a>
        <a href="/admin?section=safety" class="<%= section === 'safety' ? 'active' : '' %>">Safety Rules</a>
        <a href="/admin?section=waivers" class="<%= section === 'waivers' ? 'active' : '' %>">Waivers</a>
        <a href="/admin?section=calendar" class="<%= section === 'calendar' ? 'active' : '' %>">Appointments</a>
        <a href="/admin?section=events" class="<%= section === 'events' ? 'active' : '' %>">Events</a>
        <a href="/admin?section=images" class="<%= section === 'images' ? 'active' : '' %>">Images</a>
        <a href="/admin?section=views" class="<%= section === 'views' ? 'active' : '' %>">Views</a>
        <a href="/admin/account">Account</a>
        <a href="/" target="_blank" class="btn btn-primary btn-sm" style="margin-left:8px">View Site &nearr;</a>
        <form method="post" action="/admin/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-ghost btn-sm">Log Out</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="container admin-main">
    <div class="admin-title-row">
      <h1>Edit Your Website</h1>
      <span class="admin-username">Signed in as <%= username %></span>
    </div>

    <% if (saveError) { %>
      <div class="alert alert-error"><%= saveError %></div>
    <% } %>

    <% if (saved) { %>
      <div class="alert alert-success">Changes saved successfully.</div>
    <% } %>

    <!-- Biography & About -->
    <section class="admin-section" id="section-bio">
      <h2>Biography &amp; About</h2>

      <!-- Profile picture -->
      <h3 style="margin-top:4px">Profile Picture</h3>
      <div class="profile-upload">
        <% if (profileImage) { %>
          <img class="profile-preview" src="/image/<%= profileImage.id %>" alt="Profile" />
        <% } else { %>
          <div class="profile-preview profile-preview-empty">No photo yet</div>
        <% } %>
        <div class="profile-upload-actions">
          <input type="hidden" id="profile-csrf" value="<%= csrfToken %>" />
          <input type="file" id="profile-file-input" accept="image/*" style="display:none" />
          <button type="button" class="btn btn-ghost" id="profile-upload-btn">Upload Photo</button>
        </div>
      </div>

      <hr style="border:none;border-top:1px solid var(--border);margin:28px 0" />

      <form method="post" action="/admin/content" class="admin-form" id="content-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          Name
          <input type="text" name="bio_name" value="<%= content.bio_name || '' %>" />
        </label>
        <label>
          Title
          <input type="text" name="bio_title" value="<%= content.bio_title || '' %>" />
        </label>

        <label>Biography</label>
        <div class="rich-editor">
          <div class="rich-toolbar" data-target="bio_body_editor">
            <button type="button" data-cmd="bold" title="Bold"><strong>B</strong></button>
            <button type="button" data-cmd="italic" title="Italic"><em>I</em></button>
            <button type="button" data-cmd="underline" title="Underline"><u>U</u></button>
            <button type="button" data-cmd="insertUnorderedList" title="Bullet list">&bull;&nbsp;List</button>
            <button type="button" data-cmd="insertOrderedList" title="Numbered list">1. List</button>
            <button type="button" data-cmd="formatBlock" data-value="h3" title="Heading">H</button>
            <button type="button" data-cmd="formatBlock" data-value="p" title="Paragraph">P</button>
          </div>
          <div class="rich-content" id="bio_body_editor" contenteditable="true"><%= content.bio_body || '' %></div>
          <textarea name="bio_body" id="bio_body_textarea" rows="1" style="display:none"></textarea>
        </div>

        <label>About / Company Info</label>
        <div class="rich-editor">
          <div class="rich-toolbar" data-target="about_body_editor">
            <button type="button" data-cmd="bold"><strong>B</strong></button>
            <button type="button" data-cmd="italic"><em>I</em></button>
            <button type="button" data-cmd="underline"><u>U</u></button>
            <button type="button" data-cmd="insertUnorderedList">&bull;&nbsp;List</button>
            <button type="button" data-cmd="insertOrderedList">1. List</button>
            <button type="button" data-cmd="formatBlock" data-value="h3">H</button>
            <button type="button" data-cmd="formatBlock" data-value="p">P</button>
          </div>
          <div class="rich-content" id="about_body_editor" contenteditable="true"><%= content.about_body || '' %></div>
          <textarea name="about_body" id="about_body_textarea" rows="1" style="display:none"></textarea>
        </div>

        <label>
          About Closing Line
          <input type="text" name="about_line" value="<%= content.about_line || '' %>" />
        </label>
        <button type="submit" class="btn btn-primary">Save Biography &amp; About</button>
      </form>
    </section>

    <!-- Courses -->
    <section class="admin-section" id="section-courses">
      <h2>Courses</h2>
      <p class="admin-sub">Edit each course directly below. Focus points are one per line. <a href="/classes" target="_blank" class="text-link">Preview the Classes page &rarr;</a></p>

      <form method="post" action="/admin/courses-form" class="admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% courses.forEach(function (c, idx) { %>
          <div class="course-editor" data-index="<%= idx %>">
            <h3><%= c.name %></h3>
            <input type="hidden" name="course_<%= idx %>_id" value="<%= c.id %>" />
            <label>
              Course name
              <input type="text" name="course_<%= idx %>_name" value="<%= c.name %>" />
            </label>
            <label>
              Short introduction
              <textarea name="course_<%= idx %>_intro" rows="2"><%= c.intro %></textarea>
            </label>
            <label>
              Focus points (one per line)
              <textarea name="course_<%= idx %>_focuses" rows="5"><%= (c.focuses || []).join('\n') %></textarea>
            </label>
            <div class="form-grid">
              <label>
                Experience required
                <input type="text" name="course_<%= idx %>_experience" value="<%= c.experience %>" />
              </label>
              <label>
                Firearm
                <input type="text" name="course_<%= idx %>_firearm" value="<%= c.firearm %>" />
              </label>
              <label>
                Ammunition
                <input type="text" name="course_<%= idx %>_ammunition" value="<%= c.ammunition %>" />
              </label>
              <label>
                Price
                <input type="text" name="course_<%= idx %>_price" value="<%= c.price || '' %>" placeholder="e.g. $150" />
              </label>
              <label>
                Minimum age
                <input type="text" name="course_<%= idx %>_minimumAge" value="<%= c.minimumAge %>" />
              </label>
            </div>
          </div>
        <% }) %>
        <button type="submit" class="btn btn-primary">Save All Courses</button>
      </form>
    </section>

    <!-- Safety Rules -->
    <section class="admin-section" id="section-safety">
      <h2>Safety Rules</h2>
      <form method="post" action="/admin/safety" class="admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          Intro paragraph
          <textarea name="safety_intro" rows="3"><%= content.safety_intro || '' %></textarea>
        </label>
        <label>
          Safety rules JSON
          <textarea name="safety_rules" rows="28" class="mono"><%= content.safety_rules || '' %></textarea>
        </label>
        <label>
          Closing line
          <input type="text" name="safety_closing" value="<%= content.safety_closing || '' %>" />
        </label>
        <button type="submit" class="btn btn-primary">Save Safety Rules</button>
      </form>
      <p class="admin-sub">Rules use the format: a list of <code>{ "title": "...", "body": ["...", "..."] }</code>.</p>
    </section>

    <!-- Waivers -->
    <section class="admin-section" id="section-waivers">
      <h2>Signed Waivers (<%= waiverCount || 0 %>)</h2>
      <% if (waivers && waivers.length) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>DOB</th>
              <th>Signed</th>
            </tr>
          </thead>
          <tbody>
            <% waivers.forEach(function (w) { %>
              <tr>
                <td><%= w.full_name %></td>
                <td><%= w.email %></td>
                <td><%= w.phone || '—' %></td>
                <td><%= w.date_of_birth || '—' %></td>
                <td><%= new Date(w.signed_at).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-sub">No waivers have been signed yet.</p>
      <% } %>
    </section>

    <!-- Calendar -->
    <section class="admin-section" id="section-calendar">
      <h2>Appointments</h2>
      <% if (appointments && appointments.length) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>When</th>
              <th>Customer</th>
              <th>Email</th>
              <th>Course</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% appointments.forEach(function (a) { %>
              <tr>
                <td><%= new Date(a.scheduled_at).toLocaleString() %></td>
                <td><%= a.customer_name %></td>
                <td><%= a.email %></td>
                <td><%= a.course %></td>
                <td><%= a.status %></td>
                <td>
                  <% if (a.status !== 'cancelled') { %>
                    <form method="post" action="/admin/appointments/cancel" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="id" value="<%= a.id %>" />
                      <button type="submit" class="btn btn-ghost btn-sm">Cancel</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/admin/appointments/confirm" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="id" value="<%= a.id %>" />
                      <button type="submit" class="btn btn-ghost btn-sm">Reinstate</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-sub">No appointments booked yet.</p>
      <% } %>
    </section>

    <!-- Events (owner-created calendar) -->
    <section class="admin-section" id="section-events">
      <h2>Manage Events</h2>
      <form method="post" action="/admin/events" class="admin-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>
          Event title
          <input type="text" name="title" required />
        </label>
        <label>
          Link to course (optional)
          <select name="course_id">
            <option value="">— Not linked —</option>
            <% courses.forEach(function (c) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Starts at
          <input type="datetime-local" name="starts_at" required />
        </label>
        <label>
          Ends at (optional)
          <input type="datetime-local" name="ends_at" />
        </label>
        <label>
          Location
          <input type="text" name="location" />
        </label>
        <label>
          Price (e.g. "$150")
          <input type="text" name="price" />
        </label>
        <label>
          Description
          <textarea name="description" rows="3"></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Add Event</button>
      </form>

      <% if (events && events.length) { %>
        <table class="admin-table" style="margin-top:20px">
          <thead>
            <tr><th>Title</th><th>Starts</th><th>Course</th><th></th></tr>
          </thead>
          <tbody>
            <% events.forEach(function (e) { %>
              <tr>
                <td><%= e.title %></td>
                <td><%= new Date(e.starts_at).toLocaleString() %></td>
                <td><%= e.course_name || '—' %></td>
                <td>
                  <form method="post" action="/admin/events/delete" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="id" value="<%= e.id %>" />
                    <button type="submit" class="btn btn-ghost btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>

    <!-- Images (drag-and-drop slideshow) -->
    <section class="admin-section" id="section-images">
      <h2>Slideshow Images</h2>
      <p class="admin-sub">Drag and drop images here to add them to the homepage slideshow, or click to browse.</p>
      <input type="hidden" id="csrf-token" value="<%= csrfToken %>" />
      <div class="dropzone" id="image-dropzone">
        <p>Drop images here</p>
        <p class="admin-sub" style="margin:0">or click to select files</p>
        <input type="file" id="image-file-input" accept="image/*" multiple style="display:none" />
      </div>

      <div class="image-thumbs" id="image-thumbs">
        <% images.forEach(function (img) { %>
          <div class="image-thumb">
            <img src="/image/<%= img.id %>" alt="<%= img.filename %>" />
            <button class="remove-img" data-id="<%= img.id %>" title="Remove">&times;</button>
          </div>
        <% }) %>
      </div>
      <% if (!images.length) { %>
        <p class="admin-sub">No images yet.</p>
      <% } %>
    </section>

    <!-- Page Views -->
    <section class="admin-section" id="section-views">
      <h2>Page Views</h2>
      <% if (viewCounts && Object.keys(viewCounts).length) { %>
        <table class="admin-table">
          <thead>
            <tr><th>Page</th><th>Views</th></tr>
          </thead>
          <tbody>
            <% Object.keys(viewCounts).forEach(function (path) { %>
              <tr><td><%= path %></td><td><%= viewCounts[path] %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="admin-sub">No page views recorded yet.</p>
      <% } %>
    </section>
  </main>

  <script src="/js/main.js"></script>
</body>
</html>
