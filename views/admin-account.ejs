<%- include('partials/admin-top') %>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>

      <section class="admin-card admin-card-narrow">
        <form method="post" action="/admin/account" class="admin-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label>
            Current password
            <input type="password" name="currentPassword" autocomplete="current-password" required />
          </label>
          <label>
            Username
            <input type="text" name="newUsername" value="<%= username %>" autocomplete="username" />
          </label>
          <div class="form-grid">
            <label>
              New password
              <input type="password" name="newPassword" autocomplete="new-password" minlength="12" />
            </label>
            <label>
              Confirm new password
              <input type="password" name="confirmPassword" autocomplete="new-password" />
            </label>
          </div>
          <p class="admin-hint">Leave the new password blank to keep your current one. Passwords must be at least 12 characters.</p>
          <button type="submit" class="btn btn-primary">Update Account</button>
        </form>
      </section>

<%- include('partials/admin-bottom') %>
