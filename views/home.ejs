<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <p class="hero-eyebrow">Structured Firearms &amp; Marksmanship Coaching</p>
    <h1>Fundamentals First.<br />Confidence Follows.</h1>
    <p class="hero-sub">
      Safety-focused, individualized coaching that builds dependable skills —
      from your first firearm to advanced defensive training.
    </p>
    <div class="hero-actions">
      <a href="/classes" class="btn btn-primary">View Courses</a>
      <a href="/biography" class="btn btn-ghost">Meet the Coach</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="feature-grid">
      <div class="feature-card">
        <h3>Safety First</h3>
        <p>Every lesson emphasizes safe firearm handling as the foundation for everything else that follows.</p>
      </div>
      <div class="feature-card">
        <h3>Individualized Coaching</h3>
        <p>Instruction is tailored to your skill level and goals — never a one-size-fits-all approach.</p>
      </div>
      <div class="feature-card">
        <h3>Progressive Skills</h3>
        <p>A clear path from core marksmanship through applied performance to dynamic shooting, so progress is measurable.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="split">
      <div>
        <h2>Why Front Line Refinement?</h2>
        <p>
          Coaching is not about overwhelming you with complicated terminology.
          It's about creating a safe, comfortable environment where you can ask
          questions, understand your firearm, and build dependable skills at your
          own pace.
        </p>
        <p>
          Every repetition is made intentional — giving you the knowledge to keep
          improving long after the session ends.
        </p>
        <a href="/about" class="btn btn-primary">Learn More</a>
      </div>
      <div class="split-accent">
        <blockquote>
          "Fundamentals First. Confidence Follows."
        </blockquote>
      </div>
    </div>
  </div>
</section>

<% if (images && images.length) { %>
<section class="section section-alt">
  <div class="container">
    <h2>Gallery</h2>
    <div class="slideshow">
      <% images.forEach((img, i) => { %>
        <img
          class="slide <%= i === 0 ? 'active' : '' %>"
          src="/image/<%= img.id %>"
          alt="Gallery image <%= i + 1 %>"
          loading="<%= i === 0 ? 'eager' : 'lazy' %>"
        />
      <% }) %>
      <% if (images.length > 1) { %>
        <button class="slide-btn prev" aria-label="Previous">&larr;</button>
        <button class="slide-btn next" aria-label="Next">&rarr;</button>
        <div class="slide-dots">
          <% images.forEach((img, i) => { %>
            <span class="dot <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>"></span>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <h2>Training Pathways</h2>
    <p class="section-lede">Three stages build on one another so you can start where you are and grow from there.</p>
    <div class="pathway-list">
      <div class="pathway">
        <span class="pathway-num">1</span>
        <div>
          <h3>Core Marksmanship</h3>
          <p>Pistol 1 &amp; Rifle 1 — establish reliable fundamentals you can build on.</p>
        </div>
      </div>
      <div class="pathway">
        <span class="pathway-num">2</span>
        <div>
          <h3>Applied Performance</h3>
          <p>Pistol 2 &amp; Rifle 2 — become faster, more consistent, and more decisive.</p>
        </div>
      </div>
      <div class="pathway">
        <span class="pathway-num">3</span>
        <div>
          <h3>Dynamic Shooting</h3>
          <p>Controlled movement applied in increasingly dynamic environments.</p>
        </div>
      </div>
    </div>
    <a href="/safety" class="text-link">Read the full safety rules before you book &rarr;</a>
  </div>
</section>

<%- include('partials/footer') %>
